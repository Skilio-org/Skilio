# Compose & Ingress
COMPOSE_FILE=compose.yml:compose.deploy.yml
DOMAIN=skilio.works
ACME_EMAIL=admin@skilio.works

# Application & Security
FASTAPI_ENV=production
ENV=production
PROJECT_NAME="Skilio"
HOST=https://${DOMAIN}
FRONTEND_HOST=https://${DOMAIN}
SECRET_KEY=generate_a_random_secure_hex_key_for_production_32_bytes_min
FIRST_SUPERUSER=admin@skilio.works
FIRST_SUPERUSER_PASSWORD=ChangeThisStrongAdminPassword2026!

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_a_secure_database_password_2026
POSTGRES_DB=app

# Monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=generate_a_secure_grafana_password_2026

# Email Delivery
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=False
EMAILS_FROM_EMAIL=no-reply@skilio.works
RESEND_API_KEY="re_changethis_to_your_resend_api_key"

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_USERINFO_URL=https://www.googleapis.com/oauth2/v3/userinfo
GOOGLE_REDIRECT_URI=https://${DOMAIN}/googleAuth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth

# LinkedIn OAuth 2.0
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://${DOMAIN}/linkedinAuth
LINKEDIN_AUTH_URI=https://www.linkedin.com/oauth/v2/authorization
LINKEDIN_TOKEN_URI=https://www.linkedin.com/oauth/v2/accessToken
LINKEDIN_USERINFO_URL=https://api.linkedin.com/v2/userinfo

# Frontend OAuth Endpoints
VITE_GOOGLE_OAUTH_URL=https://${DOMAIN}/api/v1/login/google
VITE_LINKEDIN_OAUTH_URL=https://${DOMAIN}/api/v1/login/linkedin
