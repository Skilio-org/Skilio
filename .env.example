# Application & Security
FASTAPI_ENV=development
ENV=development
DOMAIN=localhost
PROJECT_NAME="Skilio"
HOST=http://localhost:8000
FRONTEND_HOST=http://localhost:5173

SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis
POSTGRES_DB=app
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@${DOMAIN}:5432/app

# Database Backup & Retention
BACKUP_MAX_COUNT=7
BACKUP_SCHEDULE="0 2 * * *"

# Email Delivery (Mailpit & Resend)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=False
EMAILS_FROM_EMAIL=no-reply@skilio.works
RESEND_API_KEY="re_changethisintourkey"

# Cloudinary CDN Media Storage
CLOUDINARY_CLOUD_NAME=example.getitfromclaudinary.org
CLOUDINARY_API_KEY=example.getitfromclaudinary.org
CLOUDINARY_API_SECRET=example.getitfromclaudinary.org

# Google OAuth 2.0
GOOGLE_CLIENT_ID=id
GOOGLE_CLIENT_SECRET=changethis
GOOGLE_USERINFO_URL="https://www.googleapis.com/oauth2/v3/userinfo"
GOOGLE_REDIRECT_URI=${FRONTEND_HOST}/googleAuth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth

# LinkedIn OAuth 2.0
LINKEDIN_CLIENT_ID=id
LINKEDIN_CLIENT_SECRET=changethis
LINKEDIN_REDIRECT_URI=${FRONTEND_HOST}/linkedinAuth
LINKEDIN_AUTH_URI="https://www.linkedin.com/oauth/v2/authorization"
LINKEDIN_TOKEN_URI="https://www.linkedin.com/oauth/v2/accessToken"
LINKEDIN_USERINFO_URL="https://api.linkedin.com/v2/userinfo"

# Frontend Environment Variables
VITE_API_URL=${HOST}
MAILPIT_HOST=http://${DOMAIN}:8025
VITE_GOOGLE_OAUTH_URL=${HOST}/api/v1/login/google
VITE_LINKEDIN_OAUTH_URL=${HOST}/api/v1/login/linkedin

# Monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin01234

# Machine Port & Socket Overrides (Optional / 1337 rootless Docker)
# PROXY_PORT=8080
# HTTPS_PORT=8443
# REDIS_PORT=6780
# DOCKER_SOCKET=/run/user/102473/docker.sock

# Default Avatar URL
DEFAULT_AVATAR_URL=https://res.cloudinary.com/vrreelhh/image/upload/v1794764194/skilio-default.png
