# ==============================================================================
# Skilio Production Environment Configuration Template
# ==============================================================================
# This file defines production variables for deploying on AWS EC2.
# Copy this file to .env on the production server (/opt/skilio/.env).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Docker Compose Override Isolation (CRITICAL SECURITY)
# ------------------------------------------------------------------------------
# Forces Docker Compose to merge only production files and IGNORE compose.override.yml
# (Prevents local development shortcuts like exposed DB port 5432 from leaking to AWS).
COMPOSE_FILE=compose.yml:compose.deploy.yml

# ------------------------------------------------------------------------------
# 2. Domain & Automated SSL (Let's Encrypt / ACME)
# ------------------------------------------------------------------------------
# Primary Production Domain (Custom Domain):
DOMAIN=skilio.works

# Let's Encrypt ACME notification email (used for cert registration and renewal alerts)
ACME_EMAIL=admin@skilio.works

# ------------------------------------------------------------------------------
# 3. Application Environment & Core Secrets
# ------------------------------------------------------------------------------
FASTAPI_ENV=production
PROJECT_NAME="Skilio"

# Cryptographic Secret Key for JWT token signing (change in live production)
SECRET_KEY=generate_a_random_secure_hex_key_for_production_32_bytes_min

# Initial Superuser Account (created during first database migration)
FIRST_SUPERUSER=admin@skilio.works
FIRST_SUPERUSER_PASSWORD=ChangeThisStrongAdminPassword2026!

# ------------------------------------------------------------------------------
# 4. PostgreSQL Database
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_a_secure_database_password_2026
POSTGRES_DB=app

# ------------------------------------------------------------------------------
# 5. Monitoring (Grafana Credentials)
# ------------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=generate_a_secure_grafana_password_2026

# ------------------------------------------------------------------------------
# 6. Email (SMTP / Mail Delivery)
# ------------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=False
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=no-reply@skilio.works

# ------------------------------------------------------------------------------
# 7. Optional Third-Party Integrations (OAuth & Cloudinary)
# ------------------------------------------------------------------------------
SENTRY_DSN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_USERINFO_URL=https://www.googleapis.com/oauth2/v3/userinfo
GOOGLE_REDIRECT_URI=https://${DOMAIN}/googleAuth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://${DOMAIN}/linkedinAuth
LINKEDIN_AUTH_URI=https://www.linkedin.com/oauth/v2/authorization
LINKEDIN_TOKEN_URI=https://www.linkedin.com/oauth/v2/accessToken
LINKEDIN_USERINFO_URL=https://api.linkedin.com/v2/userinfo
